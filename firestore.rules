rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is the specified owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if the user is the designated Admin
    // Admin email is apexms0905@gmail.com, or user with role == 'admin'
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'apexms0905@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // USERS COLLECTION
    // Storing basic profile info for sharing between friends
    match /users/{userId} {
      // Authenticated users can read other users' profiles to find friends for sharing
      allow read: if isAuthenticated();
      
      // Users can create/update their own profile
      allow create, update: if isOwner(userId);
      
      // Admin can manage any user document
      allow delete: if isAdmin();
    }

    // SHARED NOTES COLLECTION
    match /shared_notes/{noteId} {
      // Read access:
      // 1. User is Admin
      // 2. User is the author
      // 3. Note is shared with 'all'
      // 4. Note is explicitly shared with user's UID or Email
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        'all' in resource.data.sharedWith ||
        request.auth.uid in resource.data.sharedWith ||
        (resource.data.sharedWithEmails != null && request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );

      // Create: Authenticated user creating their own note
      allow create: if isAuthenticated() && 
                    request.resource.data.authorId == request.auth.uid;

      // Update: 
      // 1. Author or Admin updating content
      // 2. Any authorized viewer adding a reaction or updating reaction map
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        (
          // Allow reacting if user has read access
          ('all' in resource.data.sharedWith || request.auth.uid in resource.data.sharedWith) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionsCount', 'commentsCount'])
        )
      );

      // Delete: Only note author or Admin
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid
      );

      // COMMENTS SUBCOLLECTION
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          resource.data.authorId == request.auth.uid
        );
      }
    }

    // SHARED SONGS COLLECTION
    match /shared_songs/{songId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        'all' in resource.data.sharedWith ||
        request.auth.uid in resource.data.sharedWith ||
        (resource.data.sharedWithEmails != null && request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );

      allow create: if isAuthenticated() && 
                    request.resource.data.authorId == request.auth.uid;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid
      );
    }
  }
}
