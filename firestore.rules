rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is the specified owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if the user is the designated Admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'apexms0905@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAdmin();
    }

    // CHAT ROOMS (WhatsApp-style Groups & Direct Chats with Anonymous & Authenticated support)
    match /chat_rooms/{roomId} {
      // Anyone can read public rooms or their own chats
      allow read: if true;

      // Anyone can create a room or update last message
      allow create, update: if true;

      // Only Room creator or Admin can delete
      allow delete: if isAdmin();

      // MESSAGES SUBCOLLECTION (Realtime chat stream)
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string && request.resource.data.text.size() > 0;
        allow delete: if true;
      }
    }

    // SHARED NOTES COLLECTION
    match /shared_notes/{noteId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;

      // COMMENTS SUBCOLLECTION
      match /comments/{commentId} {
        allow read, create, delete: if true;
      }
    }

    // SHARED SONGS COLLECTION
    match /shared_songs/{songId} {
      allow read, create, update, delete: if true;
    }
  }
}
