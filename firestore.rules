rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is the specified owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if the user is the designated Admin (strictly by token email)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email.lower() == 'apexms0905@gmail.com';
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAdmin();
    }

    // FRIEND REQUESTS COLLECTION
    match /friend_requests/{reqId} {
      // Any authenticated user can read (client-side filtering applied)
      allow read: if isAuthenticated();
      // Only the sender can create a request
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      // Sender or receiver can update (e.g. accept)
      allow update: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.toEmail == request.auth.token.email.lower() ||
        resource.data.fromUid == request.auth.uid ||
        isAdmin()
      );
      // Sender or receiver can delete (e.g. decline, unfriend)
      allow delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        isAdmin()
      );
    }

    // BLOCKED USERS COLLECTION
    match /blocked_users/{blockId} {
      // Any authenticated user can read (client-side filtering applied)
      allow read: if isAuthenticated();
      // Only the blocker can create
      allow create: if isAuthenticated() && request.resource.data.blockerUid == request.auth.uid;
      // Only the blocker or admin can delete (unblock)
      allow delete: if isAuthenticated() && (resource.data.blockerUid == request.auth.uid || isAdmin());
    }

    // CHAT ROOMS
    match /chat_rooms/{roomId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);

      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.text is string && request.resource.data.text.size() > 0;
        allow update: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
        allow delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // SHARED NOTES COLLECTION
    match /shared_notes/{noteId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());

      // COMMENTS SUBCOLLECTION
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }

    // SHARED SONGS COLLECTION
    match /shared_songs/{songId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.addedByUid == request.auth.uid || isAdmin());
    }
  }
}
