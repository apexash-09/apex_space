rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Check if user is the specified owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: Check if the user is the designated Admin
    // Admin email is apexms0905@gmail.com, or user with role == 'admin'
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'apexms0905@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      allow delete: if isAdmin();
    }

    // CHAT ROOMS (WhatsApp-style Groups & Direct Chats)
    match /chat_rooms/{roomId} {
      // Read access: Admin, public room ('all' in members), or room member
      allow read: if isAuthenticated() && (
        isAdmin() ||
        'all' in resource.data.members ||
        request.auth.uid in resource.data.members ||
        (resource.data.memberEmails != null && request.auth.token.email.lower() in resource.data.memberEmails)
      );

      // Create: Authenticated user creating room
      allow create: if isAuthenticated();

      // Update: Admin, creator, or member updating lastMessage
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        'all' in resource.data.members
      );

      // Delete: Room creator or Admin
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid
      );

      // MESSAGES SUBCOLLECTION
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      request.resource.data.senderId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          resource.data.senderId == request.auth.uid
        );
      }
    }

    // SHARED NOTES COLLECTION
    match /shared_notes/{noteId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        'all' in resource.data.sharedWith ||
        request.auth.uid in resource.data.sharedWith ||
        (resource.data.sharedWithEmails != null && request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );

      allow create: if isAuthenticated() && 
                    request.resource.data.authorId == request.auth.uid;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        (
          ('all' in resource.data.sharedWith || request.auth.uid in resource.data.sharedWith) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'reactionsCount', 'commentsCount'])
        )
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid
      );

      // COMMENTS SUBCOLLECTION
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && 
                      request.resource.data.authorId == request.auth.uid;
        allow delete: if isAuthenticated() && (
          isAdmin() ||
          resource.data.authorId == request.auth.uid
        );
      }
    }

    // SHARED SONGS COLLECTION
    match /shared_songs/{songId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        'all' in resource.data.sharedWith ||
        request.auth.uid in resource.data.sharedWith ||
        (resource.data.sharedWithEmails != null && request.auth.token.email.lower() in resource.data.sharedWithEmails)
      );

      allow create: if isAuthenticated() && 
                    request.resource.data.authorId == request.auth.uid;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
      );

      allow delete: if isAuthenticated() && (
        isAdmin() ||
        resource.data.authorId == request.auth.uid
      );
    }
  }
}
